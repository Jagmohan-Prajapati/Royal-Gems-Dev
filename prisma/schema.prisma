datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum OtpType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  orders    Order[]
  addresses Address[]
}

model Product {
  id          String      @id @default(uuid())
  name        String
  description String
  price       Int // price in INR
  images      String[]
  category    String
  stoneType   String
  stoneColor  String
  featured    Boolean     @default(false)
  caratWeight Float       @default(1.0)
  dimensions  String?
  clarity     String?
  treatments  String?
  origin      String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String // e.g. "PRIMARY RESIDENCE", "VACATION HOME"
  name      String
  phone     String
  street    String
  city      String
  pincode   String
  country   String   @default("India")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Order {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency         String      @default("INR")
  amount           Int // total amount in INR
  status           OrderStatus @default(PENDING)
  isPaid           Boolean     @default(false)
  paymentId        String? // Paytm Txn ID
  paymentSignature String? // Paytm checksum or token
  addressId        String?
  address          Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  items            OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  price     Int // historical active price at time of purchase
}

model OtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  type      OtpType
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
